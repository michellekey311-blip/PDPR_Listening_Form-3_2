<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Listening Worksheet – Set 1</title>
<style>
:root{--bg:#f4f7f9;--card:#fff;--ink:#1b2a35;--mut:#5b6b77;--acc:#1f6f8b;--line:#d5dee4;--ok:#1e8449;--no:#c0392b}
@media(prefers-color-scheme:dark){:root{--bg:#141b20;--card:#1d272e;--ink:#e8eef2;--mut:#9fb0bb;--acc:#5bb4d1;--line:#33434d}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,"Segoe UI","Noto Sans SC",sans-serif}
main{max-width:860px;margin:0 auto;padding:16px}
h1{font-size:1.5rem;margin:8px 0}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;margin:16px 0}
h2{margin:0 0 4px;font-size:1.2rem;color:var(--acc)}
.sub{color:var(--mut);font-size:.92rem;margin:0 0 10px}
.row{display:flex;gap:12px;flex-wrap:wrap}
.row label{flex:1;min-width:200px;font-weight:600}
input[type=text],select{width:100%;padding:10px;font-size:1rem;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);margin-top:4px}
.ins{font-size:.88rem;background:var(--bg);border-left:4px solid var(--acc);padding:8px 12px;border-radius:6px;margin:10px 0}
.ins p{margin:2px 0}
audio{width:100%;margin-top:6px}
.spd{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:6px 0 14px;font-size:.9rem}
.spd button{padding:6px 12px;border:1px solid var(--acc);background:none;color:var(--acc);border-radius:20px;font-size:.9rem;cursor:pointer}
.spd button.on{background:var(--acc);color:#fff}
.q{padding:14px 0;border-top:1px solid var(--line)}
.q h3{font-size:1rem;margin:0 0 10px}
.pics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.pics label{display:block;border:2px solid var(--line);border-radius:10px;padding:6px;text-align:center;cursor:pointer;font-weight:700}
.pics label:has(input:checked){border-color:var(--acc);background:rgba(31,111,139,.12)}
.pics input{margin:4px 6px 0 0}
.pics img,.pics svg{width:100%;height:auto;border-radius:6px;display:block}
.pics label.right{border-color:var(--ok);background:rgba(30,132,73,.15)}
.pics label.wrong{border-color:var(--no);background:rgba(192,57,43,.13)}
.res{font-size:.9rem;font-weight:600;margin-top:6px;min-height:1px}
.good{color:var(--ok)}.bad{color:var(--no)}
.flow{display:grid;grid-template-columns:1fr 240px;gap:16px;align-items:start}
.fb{border:2px solid var(--ink);border-radius:6px;padding:10px;text-align:center;background:var(--bg)}
.fb.blank{display:flex;gap:8px;align-items:center;justify-content:center;flex-wrap:wrap}
.fb.blank select{width:auto;min-width:80px;margin:0}
.ar{text-align:center;color:var(--mut);line-height:1.2;margin:2px 0}
.opts{border:2px solid var(--ink);border-radius:12px;padding:10px 14px;font-size:.95rem}
.opts b{display:inline-block;width:1.4em}
@media(max-width:640px){.flow{grid-template-columns:1fr}}
table{width:100%;border-collapse:collapse}
td{border:1px solid var(--line);padding:12px;vertical-align:top}
td:first-child{width:38%;font-weight:600}
td input[type=text]{width:180px;display:inline-block;margin:0 4px}
.pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.pills label{border:2px solid var(--line);border-radius:20px;padding:6px 12px;cursor:pointer}
.pills label:has(input:checked){border-color:var(--acc);background:rgba(31,111,139,.12)}
.pills label.right{border-color:var(--ok);background:rgba(30,132,73,.15)}
.pills label.wrong{border-color:var(--no);background:rgba(192,57,43,.13)}
#sub{display:block;width:100%;padding:14px;font-size:1.1rem;font-weight:700;background:var(--acc);color:#fff;border:0;border-radius:10px;cursor:pointer}
#out{display:none;text-align:center}
#out .big{font-size:2.6rem;font-weight:800;color:var(--acc)}
</style></head><body><main>
<h1>Listening Worksheet – Set 1</h1>
<div class="card"><div class="row">
<label>Name / Nama / 姓名<input type="text" id="nm" autocomplete="off"></label>
<label>Class / Kelas / 班级<select id="cl"><option value="">— Select —</option><option>3 AMETHYST</option><option>3 TANZANITE</option></select></label>
</div></div>
<div id="parts"></div>
<button id="sub">Submit / Hantar / 提交</button>
<div class="card" id="out"><div>Your score / Markah anda / 你的分数</div><div class="big" id="sc"></div><div id="pp" class="sub"></div><div class="sub">Scroll up to see the correct answers. / Tatal ke atas untuk melihat jawapan betul. / 向上滑动查看正确答案。</div></div>
</main>
<script>
/* ===== TEACHER SETTINGS: paste your Google Form details here ===== */
const FORM_URL="https://docs.google.com/forms/d/e/1FAIpQLScwiaF71JieS5eFLSZn8qS730Yqlql4jCv7fZC9HtZ7GnpbxQ/formResponse";      // e.g. https://docs.google.com/forms/d/e/XXXX/formResponse
const E_NAME="entry.1514336573",E_CLASS="entry.2037847292",E_SCORE="entry.442601092"; // e.g. entry.123456789
/* ================================================================ */
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const S=x=>`<svg viewBox="0 0 120 80">${x}</svg>`;
const sky='<rect width="120" height="80" fill="#cfe6f3"/>',gr='<rect y="64" width="120" height="16" fill="#8fbf7f"/>';
const H=(x,y,c='#2a6f97',gi)=>`<circle cx="${x}" cy="${y}" r="4" fill="#f2c9a0"/><rect x="${x-4}" y="${y+5}" width="8" height="13" rx="2" fill="${c}" ${gi?'stroke="#999"':''}/>`;
const map=(px,py)=>S('<rect width="120" height="80" fill="#e8e4d8"/><rect x="55" width="10" height="80" fill="#777"/><rect y="34" width="120" height="10" fill="#777"/>'+[[10,6,35,22],[75,6,35,22],[10,50,35,24],[75,50,35,24]].map(b=>`<rect x="${b[0]}" y="${b[1]}" width="${b[2]}" height="${b[3]}" fill="#c3d3b9"/>`).join('')+`<circle cx="${px}" cy="${py}" r="6" fill="#d62828"/><text x="${px}" y="${py+2.6}" text-anchor="middle" font-size="7" fill="#fff" font-weight="700">S</text>`);
const clock=(h,m)=>{const a=(h%12+m/60)*30,b=m*6,L=(d,l,w)=>`<line x1="60" y1="40" x2="${60+l*Math.sin(d*Math.PI/180)}" y2="${40-l*Math.cos(d*Math.PI/180)}" stroke="#222" stroke-width="${w}" stroke-linecap="round"/>`;let t='';for(let i=0;i<12;i++)t+=`<line x1="${60+29*Math.sin(i*Math.PI/6)}" y1="${40-29*Math.cos(i*Math.PI/6)}" x2="${60+33*Math.sin(i*Math.PI/6)}" y2="${40-33*Math.cos(i*Math.PI/6)}" stroke="#555" stroke-width="1.5"/>`;return S(`<rect width="120" height="80" fill="#f3f3f3"/><circle cx="60" cy="40" r="36" fill="#fff" stroke="#555" stroke-width="3"/>${t}${L(a,17,3.5)}${L(b,26,2)}<circle cx="60" cy="40" r="2.5" fill="#222"/>`)};
const aud=(ys)=>ys.map(x=>`<circle cx="${x}" cy="72" r="6" fill="#4a4a4a"/>`).join('');
const P1=[
{q:'Where will Grandpa Joe go for his holiday this year?',a:'C',o:['<img src="img/q1a.jpeg" alt="A">','<img src="img/q1b.jpeg" alt="B">','<img src="img/q1c.jpeg" alt="C">']},
{q:"Which one of the following maps shows where Farid's school is?",a:'A',o:['<img src="img/q2a.png" alt="A">','<img src="img/q2b.png" alt="B">','<img src="img/q2c.png" alt="C">']},
{q:'Which workshop does Siu Chen join?',a:'A',o:['<img src="img/q3a.jpeg" alt="A">','<img src="img/q3b.jpeg" alt="B">','<img src="img/q3c.png" alt="C">']},
{q:'What is the latest time for Sameet to get to the airport?',a:'B',o:['<img src="img/q4a.png" alt="A">','<img src="img/q4b.png" alt="B">','<img src="img/q4c.png" alt="C">']},
{q:"Where did Rajoo's friends go last Friday?",a:'A',o:['<img src="img/q5a.jpeg" alt="A">','<img src="img/q5b.jpeg" alt="B">','<img src="img/q5c.jpeg" alt="C">']}];
const ST=['Get handbook','Meet Mr Abdul Muin','Collect football jersey and boots','Clock in for training','Report to team coach','Meet other players','Take a quiz'],L='ABCDEFG';
const KEY2={6:'F',7:'E',8:'A',9:'C',10:'B'};
const FLOW=['Go to the training office',6,7,'Have lunch at the canteen',8,'Learn duties','Go for tea break',9,10,"Return to Mr Perez's office"];
const T3={12:['90'],13:['100','one hundred'],14:['swimming pool','a swimming pool'],15:['opposite']},SHOW3={11:'George Street',12:'90',13:'100 / One hundred',14:'swimming pool',15:'opposite'};
const ins=`<div class="ins"><p>🇬🇧 You can play the audio again as many times as you need, and you can change the speed yourself.</p><p>🇲🇾 Kamu boleh mendengar audio ini berulang kali dan melaraskan kelajuannya sendiri.</p><p>🇨🇳 你可以重复播放录音，也可以自己调整播放速度。</p></div>`;
const warn=`<div class="ins" style="border-left-color:#e67e22"><p>⚠️ Be careful with your spelling in this part. Answers with spelling mistakes will be marked wrong.</p><p>⚠️ Berhati-hati dengan ejaan kamu dalam bahagian ini. Jawapan yang salah eja akan dianggap salah.</p><p>⚠️ 请注意本部分的拼写。拼写错误的答案将被视为错误。</p></div>`;
const player=f=>`<audio controls preload="metadata" src="${f}"></audio><div class="spd">Speed / Kelajuan / 速度: ${[.75,1,1.25].map(r=>`<button type="button" class="${r==1?'on':''}" data-r="${r}">${r}x</button>`).join('')}</div>`;
let h=`<section class="card"><h2>Part 1 · Questions 1–5</h2><p class="sub">There are five questions in this part. For each question, there are three pictures and a short recording. Choose the correct answer A, B or C.</p>${ins}${player('part1.mp3')}`;
P1.forEach((p,i)=>{const n=i+1;h+=`<div class="q" id="c${n}"><h3>${n}. ${p.q}</h3><div class="pics">${p.o.map((s,j)=>`<label>${s}<input type="radio" name="q${n}" value="${'ABC'[j]}">${'ABC'[j]}</label>`).join('')}</div><div class="res" id="r${n}"></div></div>`});
h+=`</section><section class="card"><h2>Part 2 · Questions 6–10</h2><p class="sub">You will listen to a football club manager talking to a new football player about what to do on his first day at training. For questions 6 to 10, complete the notes with options A–G.</p>${ins}${player('part2.mp3')}<h3 style="text-align:center">First Day at Football Training</h3><div class="flow"><div>`;
FLOW.forEach((f,i)=>{h+=typeof f=='number'?`<div class="fb blank"><b>${f}.</b><select id="s${f}"><option value="">—</option>${[...L].map(c=>`<option>${c}</option>`).join('')}</select><span class="res" id="r${f}"></span></div>`:`<div class="fb">${f}</div>`;if(i<FLOW.length-1)h+='<div class="ar">▼</div>'});
h+=`</div><div class="opts"><b style="width:auto">Steps:</b><br>${[...L].map((c,i)=>`<div><b>${c}</b> ${ST[i]}</div>`).join('')}</div></div></section>
<section class="card"><h2>Part 3 · Questions 11–15</h2><p class="sub">You will hear a teacher telling her students about a hotel they will stay in during a trip. For questions 11 to 15, complete the notes below. Use no more than three words and/or a number for each answer.</p>${ins}${warn}${player('part3.mp3')}<h3 style="text-align:center">Hotel Information</h3><table>
<tr><td>Town</td><td>Edinburgh</td></tr>
<tr><td>Location</td><td><b>11</b> In<div class="pills" id="c11">${['St Andrew Street','George Square','George Street'].map(o=>`<label><input type="radio" name="q11" value="${o}"> ${o}</label>`).join('')}</div><div class="res" id="r11"></div></td></tr>
<tr><td>Price for single room</td><td><b>12</b> £<input type="text" id="t12" autocomplete="off"><span class="res" id="r12"></span></td></tr>
<tr><td>Number of bedrooms</td><td><b>13</b><input type="text" id="t13" autocomplete="off"><span class="res" id="r13"></span></td></tr>
<tr><td>Facilities</td><td><b>14</b> Gym, sauna,<input type="text" id="t14" autocomplete="off"><span class="res" id="r14"></span></td></tr>
<tr><td>How to find it</td><td><b>15</b> It's<input type="text" id="t15" autocomplete="off">the post office.<span class="res" id="r15"></span></td></tr></table></section>`;
$('#parts').innerHTML=h;
$$('.spd').forEach(d=>{const a=d.previousElementSibling;d.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;a.playbackRate=+b.dataset.r;d.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x==b))})});
const mark=(n,ok,c)=>{const r=$('#r'+n);r.className='res '+(ok?'good':'bad');r.textContent=ok?'✓ Correct':'✗ Correct answer: '+c};
let done=false;
$('#sub').onclick=()=>{
 if(done)return;
 const nm=$('#nm').value.trim(),cl=$('#cl').value;
 if(!nm||!cl){alert('Please enter your name and choose your class.\nSila isi nama dan pilih kelas.\n请填写姓名并选择班级。');scrollTo({top:0,behavior:'smooth'});return}
 const unans=$$('#parts .q').filter((_,i)=>i<5&&!$(`input[name=q${i+1}]:checked`)).length+[6,7,8,9,10].filter(n=>!$('#s'+n).value).length+(($('input[name=q11]:checked'))?0:1)+[12,13,14,15].filter(n=>!$('#t'+n).value.trim()).length;
 if(unans&&!confirm(unans+' question(s) not answered. Submit anyway?\n'+unans+' soalan belum dijawab. Hantar juga?\n还有 '+unans+' 题未作答，仍要提交吗？'))return;
 done=true;let per=[0,0,0];
 P1.forEach((p,i)=>{const n=i+1,v=($(`input[name=q${n}]:checked`)||{}).value,ok=v===p.a;if(ok)per[0]++;mark(n,ok,p.a);$$(`#c${n} label`).forEach(l=>{const r=l.querySelector('input');if(r.value===p.a)l.classList.add('right');else if(r.checked)l.classList.add('wrong')})});
 for(const n in KEY2){const ok=$('#s'+n).value===KEY2[n];if(ok)per[1]++;mark(n,ok,KEY2[n]+'. '+ST[L.indexOf(KEY2[n])])}
 {const v=($('input[name=q11]:checked')||{}).value,ok=v==='George Street';if(ok)per[2]++;mark(11,ok,SHOW3[11]);$$('#c11 label').forEach(l=>{const r=l.querySelector('input');if(r.value==='George Street')l.classList.add('right');else if(r.checked)l.classList.add('wrong')})}
 for(const n in T3){const v=$('#t'+n).value.toLowerCase().replace(/[£.]/g,'').replace(/\s+/g,' ').trim(),ok=T3[n].includes(v);if(ok)per[2]++;mark(n,ok,SHOW3[n])}
 const tot=per[0]+per[1]+per[2];
 $$('input,select').forEach(e=>e.disabled=true);$('#sub').style.display='none';
 $('#sc').textContent=tot+' / 15';$('#pp').textContent=`Part 1: ${per[0]}/5 · Part 2: ${per[1]}/5 · Part 3: ${per[2]}/5`;$('#out').style.display='block';$('#out').scrollIntoView({behavior:'smooth'});
 if(FORM_URL){const b=new URLSearchParams();b.append(E_NAME,nm);b.append(E_CLASS,cl);b.append(E_SCORE,String(tot));const status=document.createElement('p');status.setAttribute('role','status');status.textContent='Sending result…';$('#out').appendChild(status);fetch(FORM_URL,{method:'POST',mode:'no-cors',body:b}).then(()=>{status.textContent='Submission request sent. This page cannot confirm that Google Forms saved your result.'}).catch(()=>{status.textContent='Submission request failed. Please tell your teacher your name, class and score.'})}
};
</script></body></html>
